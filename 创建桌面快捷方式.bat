@echo off
rem Keep this file ASCII-only: cmd parses .bat as GBK on zh-CN Windows, so
rem UTF-8 Chinese here would turn into mojibake and break the paths.
rem
rem Note: the icon is copied OUT of the project folder before the shortcut
rem points at it. When the project folder carries a low integrity label or
rem restricted ACLs (e.g. because an agent sandbox provisioned it), Explorer
rem refuses to read the icon there and the shortcut shows a blank page.

setlocal
set "APPDIR=%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
echo.
pause